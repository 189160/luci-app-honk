# native_api 配置参考（随包核心含 native_api 与内嵌面板）
#
# 整段保持注释：默认不启动监听（enabled: false）；
# 要启用就取消注释，并填好 secret（以及 listen / ui 等需要改的字段），不必更换核心。
# 下列字段改动一律要重启生效（SIGHUP 会忽略这些变更并保留当前 listener，不是报错）。
# 本文件含 secret ⇒ 会被 honk 判为凭据源而在面板里只读；这也是它独立成文件的原因：
# 写进主 config.dae 会让主文件只读，连带面板的节点/分组管理失效。
#
# 认证三选一：非空 secret（token）／password_auth: true（密码）／allow_anonymous_loopback: true
# （loopback、开发用）；secret 须为不含空白与逗号的可见 ASCII，短于 8 字节不会被遮蔽（启动时会记录提示）。
#
# ⚠️ secret 的字符序列**不能出现在任何配置源的文件正文里**（订阅 URL、注释里都算）：
#    honk 用它做整份正文的子串匹配来判定"凭据源"，命中的那个文件会连同里面的节点/分组
#    一起变成只读（面板改不动，报权限不足）。选一个不会在正文里出现的随机串，例如
#    `head -c 24 /dev/urandom | base64 | tr -d '=+/' | cut -c1-24`。
#
# experimental {
#     native_api {
#         enabled: false                 # 改成 true 才启动监听（要求 listen 为数字 IP + 非 0 端口，且已有凭据）
#         listen: '127.0.0.1:9527'       # 只接受数字 IP:port；从 LAN 访问改成 '0.0.0.0:9527'
#         secret: ''                     # 填一个 ≥8 字节的随机串
#         # 推荐 'embedded'：面板由核心自带、随核心升级，不存在与核心的两代错配
#         ui: 'embedded'
#         # ui: '/usr/share/honk/doona'    # 或填面板目录的**绝对路径**，由「面板」页在线更新（见文末提示）
#         # config_write: true           # 允许 doona 面板改写**其它**配置文件（要求 secret 非空）
#         # allowed_hosts: 'panel.example'              # 显式 host authority；不能带 scheme/路径/通配符；
#         #                                            #   省略端口表示 80，不是监听端口
#         # allow_origins: 'https://panel.example'      # 显式 origin，不能带路径
#         # record_flows: true           # record_traffic / record_memory / record_logs / record_dns_log 同理（默认全 true）
#         # —— 下面四个字段上游已移除或已迁移：旧构建里可用，新构建只给一条诊断并忽略其值 ——
#         # probe_allowed_cidrs: '192.168.0.0/16'       # 【已移除】探针不再有地址白名单
#         # probe_allowed_ports: 443                    # 【已移除】探针不再有端口白名单
#         # geosite_download_url: 'https://example.com/geosite.dat'   # 【已迁移】→ assets.geodata.geosite
#         # geoip_download_url: 'https://example.com/geoip.dat'       # 【已迁移】→ assets.geodata.geoip
#         # —— 以下两个是「接受但无效」的遗留字段，写与不写完全一样 ——
#         # config_content: true         # 读配置内容本来就不需要开关：任何通过认证的请求都可读，
#         #                              #   只有监听凭据值会被遮蔽。此字段解析后即被丢弃。
#         # writable_includes: 'x.dae'   # 既不授权也不限制；能改哪些源只看 config_write + 逐源可写性
#     }
# }
#
# 提示：allowed_hosts 只写对外域名时，本机探测会因 Host 校验被拒，面板会显示「本机探测无响应」；
#       把 '127.0.0.1:9527' 一并列入即可。
# 提示：ui 可取 'embedded'（推荐 —— 面板由核心自带，随核心升级；要求核心带 native-ui feature，随包核心含），
#       或面板目录的**绝对路径**（由本仓「面板」页在线更新）。随包核心取 fork 的最新 release，而「面板」页
#       跟随 doona 的最新 release ⇒ 目录形式下二者不同步，面板会长期落后核心一代；'embedded' 不存在该问题。
#       两种形式都由 honk 在 /ui/ 提供，面板页的探测对这二者一视同仁。
# 提示：geodata 的三个旧字段已迁到顶层 assets 段：geosite_download_url → assets.geodata.geosite、
#       geoip_download_url → assets.geodata.geoip、geodata_download_detour → assets.geodata.route。
# 提示：native_api 的未知字段会直接报错（不是忽略）；只有上面标注【已移除】【已迁移】的那几个
#       例外 —— 它们被识别为遗留字段，给一条 warning 后忽略其值。
#       字段清单以分支文档 doc/zh/reference/experimental.md 为准（该分支同时提供 assets/api/cli 等中文参考）。
