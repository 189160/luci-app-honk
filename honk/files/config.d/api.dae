# native_api 配置参考。
#
# 改完必须重启服务才生效（SIGHUP 会被忽略，不是报错）。
# 面板入口：LuCI「服务 → HONK → WebUI」，或 http://<监听地址>:<端口>/ui/
#
# 认证三选一，都不满足时 listener 起不来：
#   ① secret 非空                              → token 模式
#   ② secret 空 + password_auth: true          → 密码模式
#   ③ secret 空 + allow_anonymous_loopback: true → 仅 loopback（开发用）
#
# ⚠️ 本文件含 secret，因此会被 honk 判为凭据源 —— 在 doona 面板里【只读】，
#    只能用 LuCI 或直接改磁盘。这也是 native_api 必须独立成一个文件的原因：
#    写进主 config.dae 会让主文件也变只读，连带面板的节点/分组管理失效。

experimental {
    native_api {
        enabled: false                 # 改成 true 才启动监听
        listen: '127.0.0.1:9527'       # 只接受数字 IP:port；从 LAN 访问改成 '0.0.0.0:9527'
        secret: ''                     # 填一个 ≥8 字节的随机串（短于 8 字节不会被脱敏）
        ui: ''                         # 内嵌 doona 填 'embedded'（需二进制带 native-ui feature）
        # config_write: true           # 允许 doona 面板改写**其它**配置文件（要求 secret 非空）
        # —— 以下两个是「接受但无效」的遗留字段，写与不写完全一样 ——
        # config_content: true         # 读配置内容本来就不需要开关：任何通过认证的请求都可读，
        #                              #   只有监听凭据值会被遮蔽。此字段解析后即被丢弃。
        # writable_includes: 'x.dae'   # 既不授权也不限制；能改哪些源只看 config_write + 逐源可写性
        # allowed_hosts: 'panel.example'
        # allow_origins: 'https://panel.example'
        # record_logs: true            # record_flows / record_traffic / record_memory / record_dns_log 同理
    }
}
